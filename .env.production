DATOCMS_API_TOKEN=

# --- Edit mode admin auth ---
# Set these in your hosting provider's env settings (e.g. Vercel), NOT here.
# Generate the hash + secret with: node scripts/generate-admin-hash.mjs "your-password"
ADMIN_USER=
ADMIN_PASSWORD_HASH_B64=
SESSION_SECRET=
# DatoCMS Content Management API token with write access (server-only).
DATOCMS_CMA_TOKEN=
# Optional: pin a specific DatoCMS environment for writes (defaults to primary).
DATOCMS_ENVIRONMENT=
